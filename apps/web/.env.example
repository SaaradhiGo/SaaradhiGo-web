# Where the web app talks to the backend.
# Override per environment with .env.local (gitignored).
#
#   production  https://api.saaradhigo.com/api/v1   (NOT YET CONFIGURED --
#               api.saaradhigo.com has no DNS record at the time of writing)
#   QA          https://backend-qa-811d.up.railway.app/api/v1
#   local       http://localhost:8000/api/v1
#
# The old custom domain dev.api.saaradhigo.in is NOT usable: it resolves to
# 16.112.4.47 and times out on 443. Do not reintroduce it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# The public origin this deployment serves, used for canonical URLs, Open
# Graph and the sitemap. QA MUST set its own origin here: a QA build that
# claims https://saaradhigo.com asks search engines to index a test database
# as the real site. Only the deployment whose value is exactly
# https://saaradhigo.com allows crawling at all -- see src/app/robots.ts.
NEXT_PUBLIC_SITE_URL=https://saaradhigo.com

# The address the public contact page offers. Unset, it falls back to
# support@saaradhigo.com, whose domain has Zoho MX, SPF and DMARC records.
# Confirm the MAILBOX exists in Zoho before launch; the domain accepting mail
# is not the same as the address being read by a person.
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Comma-separated E.164 numbers that may receive a one-time code on an
# environment that does not text the public. Everything else gets the
# disabled "Send code" button and an explanation.
# NEXT_PUBLIC_QA_TEST_PHONES=
# NEXT_PUBLIC_ALLOW_OTP_SEND=false
