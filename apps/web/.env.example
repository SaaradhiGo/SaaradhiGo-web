# Where the web app talks to the backend.
# Override per environment with .env.local (gitignored).
#
# QA answers at https://backend-qa-811d.up.railway.app/api/v1 . The
# custom domain dev.api.saaradhigo.in is NOT usable: it resolves to
# 16.112.4.47 and times out on 443, so point at the Railway hostname until
# that DNS record is corrected.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# The address the public contact page offers. Unset, it falls back to
# support@saaradhigo.in -- which cannot receive mail today, because the
# domain publishes no MX record. See src/lib/support.ts.
# NEXT_PUBLIC_SUPPORT_EMAIL=
