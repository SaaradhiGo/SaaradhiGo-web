{
  "name": "saaradhigo-ops-console",
  "version": "0.1.0",
  "private": true,
  "description": "SaaradhiGo internal operations console. Multi-page Next.js app served at console.saaradhigo.com (or local). Targets the same backend the mobile apps use.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "type-check": "tsc --noEmit",
    "check-icons": "node scripts/check-icons.mjs",
    "check-tokens": "node scripts/check-tokens.mjs",
    "verify:hosts": "node scripts/verify-hosts.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:booking": "node scripts/verify-booking.mjs",
    "verify:driver-docs": "node scripts/verify-driver-docs.mjs",
    "verify:site": "node scripts/site-cert.mjs",
    "verify:scope": "node scripts/verify-scope.mjs",
    "shoot:console": "node scripts/shoot-console.mjs",
    "a11y:console": "node scripts/a11y-console.mjs"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.4",
    "typescript": "5.4.5",
    "playwright-core": "1.49.1"
  }
}
